# Создай бота в @BotFather → /newbot. Токен храни только у себя.
TELEGRAM_BOT_TOKEN=

# Числовые Telegram ID через запятую. Пусто = загрузки запрещены всем.
# При пустом списке можно узнать свой ID командой /id в личке бота.
ALLOWED_USER_IDS=

# Необязательно: cookies.txt в Netscape-формате для сайтов, требующих входа.
# Файл содержит доступ к аккаунту; не отправляй его боту и не публикуй.
COOKIES_FILE=

DOWNLOAD_TIMEOUT=180
MAX_FILE_MB=49
